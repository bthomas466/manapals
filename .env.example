# Supabase project settings (Project Settings → API in the Supabase dashboard)
# Local dev and Vercel Preview point at the STAGING project; only Vercel
# Production uses the prod project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E2E (optional): run Playwright against a deployed URL instead of local dev
# PLAYWRIGHT_BASE_URL=
# VERCEL_AUTOMATION_BYPASS_SECRET=
